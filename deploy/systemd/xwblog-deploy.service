[Unit]
Description=xwblog 自动部署（GitHub main → Docker 容器替换）
Documentation=https://github.com/lovexw/bloghao-xwblog/blob/main/docs/DEPLOY-ORACLE.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# 以 ubuntu 运行：代码目录和状态目录都归它，git 操作不会留下 root 属主文件；
# docker 通过免密 sudo 调用（脚本内部自动探测）
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
# 这台机器上要跟随 main 的实例，格式「容器|绑定地址|健康检查域名|数据目录」，分号分隔。
# 一次 git pull + 一次 build，逐个替换容器；某个实例健康检查失败只回滚它自己。
# 新增站点：把数据目录（含 tenants.json）准备好，在下面追加一段即可。
Environment="INSTANCES=xwblog-next|127.0.0.1:8788|blog.xiaowuleyi.com|/opt/xwblog-data;btchao-blog|127.0.0.1:8790|blog.btchao.com|/opt/btchao-blog/data"
ExecStart=/opt/xwblog-app/scripts/deploy-oracle.sh
# 构建+健康检查最长 20 分钟，超时视为失败
TimeoutStartSec=1200
Nice=10
IOSchedulingClass=idle
